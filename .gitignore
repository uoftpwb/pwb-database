.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Raw and processed data folders for any dataset
*/data/raw/
*/data/processed/
gallup_world_poll/scripts/generated_scripts/*
